# Servidor
PORT=3333

# Banco de dados Supabase (PostgreSQL)
# Pegue esta string no painel do Supabase:
# Connect > "Transaction pooler" (porta 6543)
# Cole abaixo e substitua [SUA-SENHA] pela senha do banco que voce definiu.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[SUA-SENHA]@aws-1-us-east-2.pooler.supabase.com:6543/postgres

# JWT - troque por uma string longa e aleatoria em producao
JWT_SECRET=troque_por_uma_frase_longa_e_aleatoria
JWT_EXPIRES_IN=7d

# Dominios institucionais aceitos no cadastro (separados por virgula)
DOMINIOS_INSTITUCIONAIS=edu.br,fatec.sp.gov.br,universidade.edu.br

# Assistente (Google Gemini) - pegue em https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui
# Opcional: fixar um modelo (ex: gemini-3.8-flash). Vazio = escolhe sozinho o mais novo.
GEMINI_MODEL=

# Carona solidaria: custo estimado por km (combustivel + desgaste), em R$
RATEIO_CUSTO_KM=0.70
# Valor minimo que sempre pode ser cobrado por passageiro, em R$
RATEIO_MINIMO=5
# Teto por passageiro quando a carona nao tem rota no mapa, em R$
RATEIO_TETO_SEM_ROTA=50
